# Environment for caam-claude-keepalive.service
# Tracked next to the unit. systemd reads this via EnvironmentFile=;
# the script also loads it so a manual run matches the service.
# Already-exported vars (CLI) win over this file.

# isolated = ping idle accounts in a private HOME, copy tokens into the vault.
#            Never touches live ~/.claude. Safe with Gas Town / other Claudes running.
# flop     = caam activate idle → ping → activate original.
#            Refuses if any Claude is using your real HOME (would swap their account).
CAAM_KEEPALIVE_MODE=isolated

# Cheap model for the pong prompt. Override if this alias disappears.
CAAM_KEEPALIVE_MODEL=claude-haiku-4-5-20251001

# Ping an idle profile when its vault access token has this much (or less) left.
# Access tokens last ~8h; 2h leaves a window for the 30m timer to catch them.
CAAM_KEEPALIVE_REFRESH_TTL=2h

# Minimum gap between pings of the same idle profile (anti-hammer).
# Not a schedule — the timer is. Near-expiry pings ignore the old 12h skip.
CAAM_KEEPALIVE_PING_EVERY=25m

# Seconds before SIGTERM on the claude ping (then SIGKILL 20s later).
CAAM_KEEPALIVE_TIMEOUT=180

# Set to 1 to log what would happen without writing vault files or calling Claude.
# CAAM_KEEPALIVE_DRY_RUN=1
